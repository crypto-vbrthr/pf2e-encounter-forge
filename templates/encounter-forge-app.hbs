<div class="encounter-forge-shell">
  <aside class="encounter-forge-library">
    <header class="encounter-forge-library-header">
      <div class="encounter-forge-library-heading">
        <h2>{{localize "PF2E_ENCOUNTER_FORGE.Library.Title"}}</h2>
        <p>{{localize "PF2E_ENCOUNTER_FORGE.Library.Hint"}}</p>
      </div>
      <nav class="encounter-forge-library-actions" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Library.ActionsLabel"}}">
        <button type="button" data-action="newBlueprint" data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.New">
          <i class="fa-solid fa-plus"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.Action.New"}}</span>
        </button>
        <button type="button" data-action="createExampleBlueprint" data-tooltip="PF2E_ENCOUNTER_FORGE.Example.Create">
          <i class="fa-solid fa-graduation-cap"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.Action.Example"}}</span>
        </button>
        <button type="button" data-action="refreshBlueprints" data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.Refresh">
          <i class="fa-solid fa-rotate"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.Action.Refresh"}}</span>
        </button>
        <button type="button" data-action="openDirector" data-tooltip="PF2E_ENCOUNTER_FORGE.Director.Open">
          <i class="fa-solid fa-clapperboard"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.Action.Director"}}</span>
        </button>
      </nav>
    </header>

    <div class="encounter-forge-library-section-label">
      <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.SavedTitle"}}</span>
    </div>

    <div class="encounter-forge-blueprint-list">
      {{#if hasBlueprints}}
        {{#each blueprints}}
          <div class="encounter-forge-blueprint-row {{#if selected}}selected{{/if}}" data-blueprint-id="{{id}}">
            <button type="button" class="encounter-forge-blueprint-select" data-action="selectBlueprint" data-blueprint-id="{{id}}">
              <span class="encounter-forge-blueprint-name">{{name}}</span>
              <span class="encounter-forge-blueprint-meta">{{localize "PF2E_ENCOUNTER_FORGE.Library.PartyShort"}} {{partySize}} × {{partyLevel}} · {{threat}}</span>
            </button>
            <button type="button" class="encounter-forge-blueprint-archive" data-action="archiveBlueprint" data-blueprint-id="{{id}}"
                    data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.Archive" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Controls.Archive"}}">
              <i class="fa-solid fa-box-archive"></i>
            </button>
            <button type="button" class="encounter-forge-blueprint-delete" data-action="deleteBlueprint" data-blueprint-id="{{id}}"
                    data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.Delete" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Controls.Delete"}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        {{/each}}
      {{else}}
        <div class="encounter-forge-empty-state compact">
          <i class="fa-regular fa-folder-open"></i>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Library.EmptyActive"}}</p>
        </div>
      {{/if}}

      {{#if hasArchivedBlueprints}}
        <div class="encounter-forge-library-subsection-label">
          <i class="fa-solid fa-box-archive"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Library.ArchiveTitle"}}</span>
        </div>
        {{#each archivedBlueprints}}
          <div class="encounter-forge-blueprint-row archived {{#if selected}}selected{{/if}}" data-blueprint-id="{{id}}">
            <button type="button" class="encounter-forge-blueprint-select" data-action="selectBlueprint" data-blueprint-id="{{id}}">
              <span class="encounter-forge-blueprint-name">{{name}}</span>
              <span class="encounter-forge-blueprint-meta">{{localize "PF2E_ENCOUNTER_FORGE.Library.PartyShort"}} {{partySize}} × {{partyLevel}} · {{threat}}</span>
            </button>
            <button type="button" class="encounter-forge-blueprint-archive restore" data-action="restoreBlueprint" data-blueprint-id="{{id}}"
                    data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.RestoreArchive" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Controls.RestoreArchive"}}">
              <i class="fa-solid fa-box-open"></i>
            </button>
            <button type="button" class="encounter-forge-blueprint-delete" data-action="deleteBlueprint" data-blueprint-id="{{id}}"
                    data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.Delete" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Controls.Delete"}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        {{/each}}
      {{/if}}
    </div>

    <footer class="encounter-forge-library-footer">
      <button type="button" class="encounter-forge-integrations-toggle" data-action="toggleIntegrations">
        <span><i class="fa-solid fa-plug"></i> {{readyIntegrations}} / {{totalIntegrations}} {{localize "PF2E_ENCOUNTER_FORGE.Library.IntegrationsReady"}}</span>
        <i class="fa-solid {{#if integrationsExpanded}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
      </button>

      {{#if integrationsExpanded}}
        <section class="encounter-forge-integrations-panel">
          <header>
            <strong>{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Title"}}</strong>
            <small>{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Hint"}}</small>
          </header>
          <div class="encounter-forge-integration-list">
            {{#each integrationRows}}
              <div class="encounter-forge-integration-row" data-state="{{state}}">
                <div class="encounter-forge-integration-info">
                  <strong>{{label}}</strong>
                  <small>{{statusLabel}}{{#if versionText}} · {{versionText}}{{/if}}</small>
                </div>
                <button type="button" class="encounter-forge-integration-switch {{#if enabled}}enabled{{else}}disabled{{/if}}"
                        data-action="toggleIntegration" data-integration-id="{{id}}"
                        {{#unless canToggle}}disabled{{/unless}}
                        data-tooltip="{{toggleLabel}}">
                  <i class="fa-solid {{#if enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
                </button>
              </div>
            {{/each}}
          </div>
          <p class="encounter-forge-integrations-note">{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Note"}}</p>
        </section>
      {{/if}}
    </footer>
  </aside>

  <main class="encounter-forge-editor">
    <header class="encounter-forge-editor-header">
      <div>
        <div class="encounter-forge-kicker">{{localize "PF2E_ENCOUNTER_FORGE.Editor.Blueprint"}}</div>
        <h1>{{draft.name}}</h1>
      </div>
      <div class="encounter-forge-save-state {{#if isDirty}}dirty{{else}}clean{{/if}}" data-dirty-indicator>
        <i class="fa-solid {{#if isDirty}}fa-pen{{else}}fa-check{{/if}}"></i>
        <span data-dirty-text>{{#if isDirty}}{{localize "PF2E_ENCOUNTER_FORGE.Editor.UnsavedChanges"}}{{else}}{{localize "PF2E_ENCOUNTER_FORGE.Editor.AllChangesSaved"}}{{/if}}</span>
      </div>
    </header>

    {{#if isExample}}
      <section class="encounter-forge-example-banner">
        <i class="fa-solid fa-graduation-cap"></i>
        <div>
          <strong>{{localize "PF2E_ENCOUNTER_FORGE.Example.BannerTitle"}}</strong>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Example.BannerHint"}}</span>
        </div>
      </section>
    {{/if}}

    <section class="encounter-forge-card">
      <div class="encounter-forge-section-title">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Editor.Basics"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Editor.BasicsHint"}}</p>
        </div>
      </div>

      <div class="encounter-forge-form-grid">
        <label class="wide">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}</span>
          <input type="text" name="name" value="{{draft.name}}" data-blueprint-field>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.PartyLevel"}}</span>
          <input type="number" name="partyLevel" min="1" max="20" value="{{draft.party.level}}" data-blueprint-field>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.PartySize"}}</span>
          <input type="number" name="partySize" min="1" max="12" value="{{draft.party.size}}" data-blueprint-field>
        </label>

        <div class="encounter-forge-party-detection wide">
          <div class="encounter-forge-party-detection-text">
            <i class="fa-solid fa-people-group"></i>
            {{#if partyDetection.available}}
              <span>
                {{localize "PF2E_ENCOUNTER_FORGE.Party.Detected"}}:
                <strong>{{partyDetection.size}}</strong> {{localize "PF2E_ENCOUNTER_FORGE.Party.PCs"}},
                {{localize "PF2E_ENCOUNTER_FORGE.Party.Average"}} <strong>{{partyDetection.averageLevelText}}</strong>
                → {{localize "PF2E_ENCOUNTER_FORGE.Fields.PartyLevel"}} <strong>{{partyDetection.partyLevel}}</strong>
                <small>({{partyDetection.sourceLabel}}{{#if partyDetection.sourceName}}: {{partyDetection.sourceName}}{{/if}})</small>
              </span>
            {{else}}
              <span>{{localize "PF2E_ENCOUNTER_FORGE.Party.NotDetected"}}</span>
            {{/if}}
          </div>
          <button type="button" data-action="detectParty" class="secondary">
            <i class="fa-solid fa-rotate"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.DetectParty"}}
          </button>
        </div>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Threat"}}</span>
          <select name="threatTarget" data-blueprint-field>
            {{#each threatOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Budget"}}</span>
          <input type="number" name="threatBudget" min="0" step="1" value="{{draft.threatBudget}}" placeholder="—" data-blueprint-field>
        </label>

        <label class="wide">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Description"}}</span>
          <textarea name="description" rows="5" data-blueprint-field>{{draft.description}}</textarea>
        </label>
      </div>
    </section>

    <section class="encounter-forge-card encounter-forge-participants-card">
      <div class="encounter-forge-section-title encounter-forge-participants-heading">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Title"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Hint"}}</p>
        </div>
        <div class="encounter-forge-participant-actions">
          <button type="button" data-action="browseParticipant" class="secondary">
            <i class="fa-solid fa-book-open"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.BrowseActors"}}
          </button>
          <button type="button" data-action="addCreatureForgeParticipant" class="secondary" {{#unless creatureForgeReady}}disabled{{/unless}}>
            <i class="fa-solid fa-dragon"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.CreatureForge"}}
          </button>
          <button type="button" data-action="addNpcForgeParticipant" class="secondary" {{#unless npcForgeReady}}disabled{{/unless}}>
            <i class="fa-solid fa-user-tie"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.NpcForge"}}
          </button>
        </div>
      </div>

      <div class="encounter-forge-participant-drop" data-participant-drop>
        <i class="fa-solid fa-arrow-down-to-bracket"></i>
        <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.DropHint"}}</span>
      </div>

      <div class="encounter-forge-budget-summary" data-budget-summary data-status="{{budget.status}}">
        <div>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.Used"}}</span>
          <strong><span data-budget-used>{{budget.usedXp}}</span> / <span data-budget-target>{{budget.targetXp}}</span> EP</strong>
        </div>
        <div>
          <span data-budget-remaining-label>{{budget.remainingLabel}}</span>
          <strong><span data-budget-remaining>{{budget.remainingAbs}}</span> EP</strong>
        </div>
        <div>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.StatusLabel"}}</span>
          <strong data-budget-status>{{budget.statusLabel}}</strong>
        </div>
        <div class="encounter-forge-budget-auto">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.AutomaticTarget"}}</span>
          <strong><span data-budget-automatic>{{budget.automaticTarget}}</span> EP</strong>
        </div>
      </div>

      <div class="encounter-forge-budget-warning" data-budget-warning {{#unless budget.unknownCount}}hidden{{/unless}}>
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "PF2E_ENCOUNTER_FORGE.Budget.UnknownHint"}}
      </div>

      {{#if hasPlaceholderParticipants}}
        <div class="encounter-forge-example-placeholder-note">
          <i class="fa-solid fa-circle-info"></i>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Example.PlaceholderHint"}}</span>
        </div>
      {{/if}}

      {{#if hasParticipants}}
        <div class="encounter-forge-participant-list">
          {{#each participants}}
            <article class="encounter-forge-participant" data-participant-id="{{id}}">
              <div class="encounter-forge-participant-identity">
                <div class="encounter-forge-participant-portrait">
                  {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-user-shield"></i>{{/if}}
                </div>
                <div class="encounter-forge-participant-name">
                  <input type="text" value="{{name}}" data-participant-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                  <span class="encounter-forge-source-badge">{{sourceLabel}}</span>
                </div>
                <div class="encounter-forge-participant-row-actions">
                  {{#if canEditSource}}
                    <button type="button" data-action="editParticipant" data-participant-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.EditSource">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                  {{/if}}
                  <button type="button" data-action="removeParticipant" data-participant-id="{{id}}" class="icon-only danger" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.Remove">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
              <div class="encounter-forge-participant-fields">
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Level"}}</span>
                  <input type="number" min="-1" max="24" step="1" value="{{levelValue}}" placeholder="—" data-participant-field="level">
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Quantity"}}</span>
                  <input type="number" min="1" max="99" step="1" value="{{quantity}}" data-participant-field="quantity">
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.RoleLabel"}}</span>
                  <select data-participant-field="role">
                    {{#each roleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupLabel"}}</span>
                  <select data-participant-field="groupId">
                    {{#each groupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
                <div class="encounter-forge-participant-xp {{#unless budgetSupported}}unsupported{{/unless}}">
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.ParticipantXp"}}</span>
                  <strong><span data-participant-xp="{{id}}">{{xpText}}</span> EP</strong>
                  <small><span data-participant-xp-each="{{id}}">{{xpEachText}}</span> × <span data-participant-xp-quantity="{{id}}">{{quantity}}</span></small>
                </div>
              </div>
              <div class="encounter-forge-participant-token-display">
                <div class="encounter-forge-participant-token-display-label">
                  <i class="fa-solid fa-id-badge"></i>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.TokenDisplay.Title"}}</span>
                  <small>{{localize "PF2E_ENCOUNTER_FORGE.Participants.TokenDisplay.Hint"}}</small>
                </div>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.TokenDisplay.Name"}}</span>
                  <select data-participant-field="tokenDisplayName">
                    {{#each tokenNameDisplayOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.TokenDisplay.HpBar"}}</span>
                  <select data-participant-field="tokenDisplayBars">
                    {{#each hpBarDisplayOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="encounter-forge-participant-empty">
          <i class="fa-solid fa-people-group"></i>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Empty"}}</p>
        </div>
      {{/if}}

      <div class="encounter-forge-groups">
        <div class="encounter-forge-groups-header">
          <div>
            <h3>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupsTitle"}}</h3>
            <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupsHint"}}</p>
          </div>
          <button type="button" data-action="addGroup" class="secondary">
            <i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.AddGroup"}}
          </button>
        </div>
        {{#if hasGroups}}
          <div class="encounter-forge-group-list">
            {{#each groups}}
              <div class="encounter-forge-group-row" data-group-id="{{id}}">
                <i class="fa-solid fa-object-group"></i>
                <input type="text" value="{{name}}" data-group-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupLabel"}}">
                <button type="button" data-action="removeGroup" data-group-id="{{id}}" class="icon-only danger" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.RemoveGroup">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </section>

    <section class="encounter-forge-card encounter-forge-flow-card">
      <div class="encounter-forge-section-title encounter-forge-flow-heading">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Title"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Hint"}}</p>
        </div>
        <div class="encounter-forge-flow-validation-summary" data-valid="{{flowReport.valid}}">
          {{#if flowReport.issueCount}}
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>{{flowReport.issueCount}} {{localize "PF2E_ENCOUNTER_FORGE.Flow.Validation.Issues"}}</span>
          {{else}}
            <i class="fa-solid fa-circle-check"></i>
            <span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Validation.Clean"}}</span>
          {{/if}}
        </div>
      </div>

      {{#if flowReport.issueCount}}
        <div class="encounter-forge-flow-issues">
          {{#each flowReport.issues}}
            <div class="encounter-forge-flow-issue" data-severity="{{severity}}">
              <i class="fa-solid {{icon}}"></i>
              <span>{{label}}</span>
              <code>{{pathLabel}}</code>
            </div>
          {{/each}}
        </div>
      {{/if}}

      <div class="encounter-forge-flow-columns">
        <section class="encounter-forge-flow-panel">
          <header>
            <div>
              <h3><i class="fa-solid fa-layer-group"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.PhasesTitle"}}</h3>
              <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.PhasesHint"}}</p>
            </div>
            <button type="button" data-action="addPhase" class="secondary"><i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AddPhase"}}</button>
          </header>
          {{#if hasPhases}}
            <div class="encounter-forge-flow-list">
              {{#each phases}}
                <article class="encounter-forge-phase-row" data-phase-id="{{id}}">
                  <div class="encounter-forge-flow-row-head">
                    <div class="encounter-forge-flow-row-title">
                      {{#if initial}}<span class="encounter-forge-initial-badge"><i class="fa-solid fa-play"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.InitialPhase"}}</span>{{/if}}
                      <input type="text" value="{{name}}" data-phase-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                    </div>
                    <div class="encounter-forge-flow-row-actions">
                      <button type="button" data-action="movePhaseUp" data-phase-id="{{id}}" class="icon-only" {{#unless canMoveUp}}disabled{{/unless}}><i class="fa-solid fa-arrow-up"></i></button>
                      <button type="button" data-action="movePhaseDown" data-phase-id="{{id}}" class="icon-only" {{#unless canMoveDown}}disabled{{/unless}}><i class="fa-solid fa-arrow-down"></i></button>
                      <button type="button" data-action="duplicatePhase" data-phase-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Duplicate"><i class="fa-regular fa-copy"></i></button>
                      <button type="button" data-action="removePhase" data-phase-id="{{id}}" class="icon-only danger"><i class="fa-solid fa-trash"></i></button>
                    </div>
                  </div>
                  <textarea rows="2" data-phase-field="description" placeholder="{{localize "PF2E_ENCOUNTER_FORGE.Flow.DescriptionPlaceholder"}}">{{description}}</textarea>
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="encounter-forge-flow-empty">{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoPhases"}}</p>
          {{/if}}
        </section>

        <section class="encounter-forge-flow-panel">
          <header>
            <div>
              <h3><i class="fa-solid fa-bullseye"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.ObjectivesTitle"}}</h3>
              <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ObjectivesHint"}}</p>
            </div>
            <button type="button" data-action="addObjective" class="secondary"><i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AddObjective"}}</button>
          </header>
          {{#if hasObjectives}}
            <div class="encounter-forge-flow-list">
              {{#each objectives}}
                <article class="encounter-forge-objective-row" data-objective-id="{{id}}">
                  <div class="encounter-forge-flow-row-head">
                    <input type="text" value="{{name}}" data-objective-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                    <div class="encounter-forge-flow-row-actions">
                      <button type="button" data-action="duplicateObjective" data-objective-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Duplicate"><i class="fa-regular fa-copy"></i></button>
                      <button type="button" data-action="removeObjective" data-objective-id="{{id}}" class="icon-only danger"><i class="fa-solid fa-trash"></i></button>
                    </div>
                  </div>
                  <div class="encounter-forge-objective-fields">
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Target"}}</span><input type="number" min="1" max="999" step="1" value="{{targetValue}}" data-objective-field="target"></label>
                    <label class="wide"><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Description"}}</span><textarea rows="2" data-objective-field="description">{{description}}</textarea></label>
                  </div>
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="encounter-forge-flow-empty">{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoObjectives"}}</p>
          {{/if}}
        </section>
      </div>

      <section class="encounter-forge-flow-panel encounter-forge-zone-panel">
        <header>
          <div>
            <h3><i class="fa-solid fa-draw-polygon"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.ZonesTitle"}}</h3>
            <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ZonesHint"}}</p>
          </div>
          <div class="encounter-forge-zone-toolbar">
            {{#if hasRegionQuickAddOptions}}
              <select data-region-quick-add aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.AddRegionAsZone"}}">
                <option value="">{{localize "PF2E_ENCOUNTER_FORGE.Flow.AddRegionAsZone"}}</option>
                {{#each regionQuickAddOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
              </select>
            {{/if}}
            <div class="encounter-forge-flow-row-actions">
              <button type="button" data-action="refreshRegions" class="secondary icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.RefreshRegions"><i class="fa-solid fa-rotate"></i></button>
              <button type="button" data-action="addZone" class="secondary"><i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AddZone"}}</button>
            </div>
          </div>
        </header>
        {{#if hasZones}}
          <div class="encounter-forge-flow-list encounter-forge-zone-list">
            {{#each zones}}
              <article class="encounter-forge-zone-row" data-zone-id="{{id}}">
                <div class="encounter-forge-flow-row-head">
                  <input type="text" value="{{name}}" data-zone-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                  <div class="encounter-forge-flow-row-actions">
                    <button type="button" data-action="duplicateZone" data-zone-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Duplicate"><i class="fa-regular fa-copy"></i></button>
                    <button type="button" data-action="removeZone" data-zone-id="{{id}}" class="icon-only danger"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
                <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.BoundRegion"}}</span><select data-zone-field="regionUuid">{{#each regionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                {{#if bindingLabel}}<small class="encounter-forge-zone-binding"><i class="fa-solid fa-link"></i> {{bindingLabel}}</small>{{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="encounter-forge-flow-empty">{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoZones"}}</p>
        {{/if}}
      </section>

      <div class="encounter-forge-flow-columns encounter-forge-flow-columns-runtime">
        <section class="encounter-forge-flow-panel">
          <header>
            <div>
              <h3><i class="fa-solid fa-bolt"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionsTitle"}}</h3>
              <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionsHint"}}</p>
            </div>
            <button type="button" data-action="addFlowAction" class="secondary"><i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AddAction"}}</button>
          </header>
          {{#if hasFlowActions}}
            <div class="encounter-forge-flow-list">
              {{#each flowActions}}
                <article class="encounter-forge-flow-action-row" data-flow-action-id="{{id}}" data-flow-action-type="{{type}}">
                  <div class="encounter-forge-flow-row-head">
                    <input type="text" value="{{name}}" data-flow-action-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                    <div class="encounter-forge-flow-row-actions">
                      <button type="button" data-action="duplicateFlowAction" data-flow-action-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Duplicate"><i class="fa-regular fa-copy"></i></button>
                      <button type="button" data-action="removeFlowAction" data-flow-action-id="{{id}}" class="icon-only danger"><i class="fa-solid fa-trash"></i></button>
                    </div>
                  </div>
                  <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionTypeLabel"}}</span><select data-flow-action-field="type">{{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{#if isPhaseTransition}}
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.TargetPhase"}}</span><select data-flow-action-field="phaseId">{{#each phaseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{/if}}
                  {{#if isObjectiveProgress}}
                    <div class="encounter-forge-flow-action-grid">
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.TargetObjective"}}</span><select data-flow-action-field="objectiveId">{{#each objectiveOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Amount"}}</span><input type="number" step="1" value="{{amountValue}}" data-flow-action-field="amount"></label>
                    </div>
                  {{/if}}
                  {{#if isDirectorMessage}}
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Message"}}</span><textarea rows="2" data-flow-action-field="message">{{message}}</textarea></label>
                  {{/if}}
                  {{#if isIntegrationAction}}
                    <div class="encounter-forge-integration-action-box">
                      {{#unless isLootAction}}
                        <div class="encounter-forge-flow-action-grid">
                          <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.TargetModeLabel"}}</span><select data-flow-action-field="targetMode">{{#each targetModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                          {{#if hasSpecificTarget}}
                            <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.TargetLabel"}}</span><select data-flow-action-field="targetId">{{#each targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                          {{/if}}
                        </div>
                      {{/unless}}
                      {{#if isAuraAction}}
                        <label class="encounter-forge-inline-checkbox"><input type="checkbox" data-flow-action-field="enabled" {{#if auraEnabledChecked}}checked{{/if}}> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AuraEnabled"}}</label>
                      {{/if}}
                      <div class="encounter-forge-integration-action-config">
                        <div>
                          <strong>{{localize "PF2E_ENCOUNTER_FORGE.Flow.IntegrationConfiguration"}}</strong>
                          <small>{{#if integrationConfigured}}{{localize "PF2E_ENCOUNTER_FORGE.Flow.IntegrationConfigured"}}{{else}}{{localize "PF2E_ENCOUNTER_FORGE.Flow.IntegrationNotConfigured"}}{{/if}} · {{integrationStatusLabel}}</small>
                        </div>
                        <button type="button" data-action="configureFlowAction" data-flow-action-id="{{id}}" class="secondary" {{#unless integrationUsable}}disabled{{/unless}}>
                          <i class="fa-solid fa-sliders"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.ConfigureIntegration"}}
                        </button>
                      </div>
                    </div>
                  {{/if}}
                  <div class="encounter-forge-flow-action-timing">
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionTimingLabel"}}</span><select data-flow-action-field="timingMode">{{#each timingModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    {{#if isDelayed}}
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionTimingAmount"}}</span><input type="number" min="1" max="999" step="1" value="{{timingAmount}}" data-flow-action-field="timingAmount"></label>
                    {{/if}}
                  </div>
                  {{#if isDelayed}}<small class="encounter-forge-flow-action-timing-hint">{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActionTimingHint"}}</small>{{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="encounter-forge-flow-empty">{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoActions"}}</p>
          {{/if}}
        </section>

        <section class="encounter-forge-flow-panel encounter-forge-trigger-panel">
          <header>
            <div>
              <h3><i class="fa-solid fa-code-branch"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.TriggersTitle"}}</h3>
              <p>{{localize "PF2E_ENCOUNTER_FORGE.Flow.TriggersHint"}}</p>
            </div>
            <button type="button" data-action="addTrigger" class="secondary"><i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Flow.AddTrigger"}}</button>
          </header>
          {{#if hasTriggers}}
            <div class="encounter-forge-flow-list">
              {{#each triggers}}
                <article class="encounter-forge-trigger-row" data-trigger-id="{{id}}">
                  <div class="encounter-forge-flow-row-head">
                    <input type="text" value="{{name}}" data-trigger-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                    <div class="encounter-forge-flow-row-actions">
                      <button type="button" data-action="duplicateTrigger" data-trigger-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Duplicate"><i class="fa-regular fa-copy"></i></button>
                      <button type="button" data-action="removeTrigger" data-trigger-id="{{id}}" class="icon-only danger"><i class="fa-solid fa-trash"></i></button>
                    </div>
                  </div>
                  <div class="encounter-forge-trigger-grid">
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.EventLabel"}}</span><select data-trigger-field="event">{{#each eventOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ActivePhase"}}</span><select data-trigger-field="activePhaseId">{{#each activePhaseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Participant"}}</span><select data-trigger-field="participantId">{{#each participantOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Objective"}}</span><select data-trigger-field="objectiveId">{{#each objectiveOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  </div>
                  {{#if isRegionEvent}}
                    <div class="encounter-forge-region-trigger-grid">
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ZoneLabel"}}</span><select data-trigger-field="zoneId">{{#each zoneOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.RegionTokenScopeLabel"}}</span><select data-trigger-field="regionTokenScope">{{#each regionTokenScopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    </div>
                  {{/if}}
                  <div class="encounter-forge-trigger-flags">
                    <label><input type="checkbox" data-trigger-field="enabled" {{#if enabledChecked}}checked{{/if}}> {{localize "PF2E_ENCOUNTER_FORGE.Flow.Enabled"}}</label>
                    <label><input type="checkbox" data-trigger-field="once" {{#if onceChecked}}checked{{/if}}> {{localize "PF2E_ENCOUNTER_FORGE.Flow.Once"}}</label>
                    <label><input type="checkbox" data-trigger-field="confirm" {{#if confirmChecked}}checked{{/if}}> {{localize "PF2E_ENCOUNTER_FORGE.Flow.RequireConfirmation"}}</label>
                  </div>

                  <div class="encounter-forge-trigger-subsection">
                    <div class="encounter-forge-trigger-subhead">
                      <strong>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Conditions"}}</strong>
                      <button type="button" data-action="addTriggerCondition" data-trigger-id="{{id}}" class="secondary compact"><i class="fa-solid fa-plus"></i></button>
                    </div>
                    <div class="encounter-forge-condition-context-grid">
                      <label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ConditionModeLabel"}}</span><select data-trigger-field="conditionMode">{{#each conditionModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      {{#if usesObjectiveConditionContext}}<label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ConditionObjectiveContext"}}</span><select data-trigger-field="conditionObjectiveId">{{#each conditionObjectiveOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                      {{#if usesGroupConditionContext}}<label><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.ConditionGroupContext"}}</span><select data-trigger-field="conditionGroupId">{{#each conditionGroupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
                    </div>
                    {{#if conditionSummary}}
                      <div class="encounter-forge-condition-summary"><i class="fa-solid fa-code-branch"></i><span><strong>{{localize "PF2E_ENCOUNTER_FORGE.Flow.When"}}:</strong> {{conditionSummary}}</span></div>
                    {{/if}}
                    {{#each conditions}}
                      <div class="encounter-forge-trigger-condition {{#if isParticipantContext}}has-participant-context{{/if}} {{#if isGroupParticipantContext}}has-group-participant-context{{/if}} {{#if isGroupMatchCount}}group-match-at-least{{/if}}" data-condition-index="{{conditionIndex}}">
                        <label class="encounter-forge-condition-negate" data-tooltip="PF2E_ENCOUNTER_FORGE.Flow.Not"><input type="checkbox" data-trigger-condition-field="negate" {{#if negateChecked}}checked{{/if}}><span>{{localize "PF2E_ENCOUNTER_FORGE.Flow.Not"}}</span></label>
                        <select class="encounter-forge-condition-field-control" data-trigger-condition-field="field">{{#each fieldOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                        {{#if isParticipantContext}}
                          <select class="encounter-forge-condition-participant-control" data-trigger-condition-field="participantId" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.ConditionParticipant"}}">{{#each participantContextOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                        {{/if}}
                        {{#if isGroupParticipantContext}}
                          <select class="encounter-forge-condition-group-control" data-trigger-condition-field="groupId" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.ConditionGroup"}}">{{#each groupContextOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                          <select class="encounter-forge-condition-group-match-control" data-trigger-condition-field="groupMatchMode" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.GroupMatchLabel"}}">{{#each groupMatchModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                          {{#if isGroupMatchCount}}<input class="encounter-forge-condition-group-count-control" type="number" min="1" step="1" value="{{groupMatchCountValue}}" data-trigger-condition-field="groupMatchCount" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.GroupMatchCount"}}">{{/if}}
                        {{/if}}
                        <select class="encounter-forge-condition-operator-control" data-trigger-condition-field="operator">{{#each operatorOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                        {{#if isPhaseContext}}
                          <select class="encounter-forge-condition-value-control" data-trigger-condition-field="value" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.Value"}}">{{#each phaseValueOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                        {{else}}
                          {{#if isBooleanContext}}
                            <select class="encounter-forge-condition-value-control" data-trigger-condition-field="value" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.Value"}}">{{#each booleanValueOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                          {{else}}
                            <input class="encounter-forge-condition-value-control" type="text" value="{{value}}" data-trigger-condition-field="value" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Flow.Value"}}">
                          {{/if}}
                        {{/if}}
                        <button type="button" data-action="removeTriggerCondition" data-trigger-id="{{../id}}" data-condition-index="{{conditionIndex}}" class="icon-only danger encounter-forge-condition-remove-control"><i class="fa-solid fa-xmark"></i></button>
                      </div>
                    {{/each}}
                  </div>

                  <div class="encounter-forge-trigger-subsection">
                    <strong>{{localize "PF2E_ENCOUNTER_FORGE.Flow.LinkedActions"}}</strong>
                    {{#if actionOptions.length}}
                      <div class="encounter-forge-trigger-actions-list">
                        {{#each actionOptions}}
                          <label><input type="checkbox" data-trigger-action="{{id}}" {{#if checked}}checked{{/if}}> <span data-trigger-action-label="{{id}}">{{label}}</span></label>
                        {{/each}}
                      </div>
                    {{else}}
                      <small>{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoActionsToLink"}}</small>
                    {{/if}}
                  </div>
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="encounter-forge-flow-empty">{{localize "PF2E_ENCOUNTER_FORGE.Flow.NoTriggers"}}</p>
          {{/if}}
        </section>
      </div>
    </section>

    <section class="encounter-forge-card encounter-forge-structure-card">
      <div class="encounter-forge-section-title">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Editor.Structure"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Editor.StructureHint"}}</p>
        </div>
      </div>

      <div class="encounter-forge-stat-grid">
        <div class="encounter-forge-stat"><strong data-structure-participant-count>{{draft.participantCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Participants"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.groupCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Groups"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.objectiveCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Objectives"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.phaseCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Phases"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.zoneCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Zones"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.triggerCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Triggers"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.actionCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Actions"}}</span></div>
      </div>

      <div class="encounter-forge-foundation-note">
        <i class="fa-solid fa-compass-drafting"></i>
        <span>{{localize "PF2E_ENCOUNTER_FORGE.Editor.FoundationNote"}}</span>
      </div>
    </section>

    <footer class="encounter-forge-editor-actions">
      <div>
        <button type="button" data-action="duplicateBlueprint" class="secondary">
          <i class="fa-regular fa-copy"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Duplicate"}}
        </button>
        {{#if draftArchived}}
          <button type="button" data-action="restoreBlueprint" class="secondary" {{#unless isSaved}}disabled{{/unless}}>
            <i class="fa-solid fa-box-open"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.RestoreArchive"}}
          </button>
        {{else}}
          <button type="button" data-action="archiveBlueprint" class="secondary" {{#unless isSaved}}disabled{{/unless}}>
            <i class="fa-solid fa-box-archive"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Archive"}}
          </button>
        {{/if}}
        <button type="button" data-action="deleteBlueprint" class="secondary danger" {{#unless isSaved}}disabled{{/unless}}>
          <i class="fa-solid fa-trash"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Delete"}}
        </button>
      </div>
      <div class="encounter-forge-editor-actions-primary">
        <button type="button" data-action="deployEncounter" class="secondary deploy" {{#unless canDeploy}}disabled{{/unless}}>
          <i class="fa-solid fa-people-arrows"></i> {{localize "PF2E_ENCOUNTER_FORGE.Deployment.Deploy"}}
        </button>
        <button type="button" data-action="saveBlueprint" class="primary">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Save"}}
        </button>
      </div>
    </footer>
  </main>
</div>
