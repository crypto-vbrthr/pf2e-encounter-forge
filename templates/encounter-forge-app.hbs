<div class="encounter-forge-shell">
  <aside class="encounter-forge-library">
    <header class="encounter-forge-library-header">
      <div>
        <h2>{{localize "PF2E_ENCOUNTER_FORGE.Library.Title"}}</h2>
        <p>{{localize "PF2E_ENCOUNTER_FORGE.Library.Hint"}}</p>
      </div>
      <div class="encounter-forge-library-actions">
        <button type="button" data-action="newBlueprint" data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.New">
          <i class="fa-solid fa-plus"></i>
        </button>
        <button type="button" data-action="refreshBlueprints" data-tooltip="PF2E_ENCOUNTER_FORGE.Controls.Refresh">
          <i class="fa-solid fa-rotate"></i>
        </button>
      </div>
    </header>

    <div class="encounter-forge-blueprint-list">
      {{#if hasBlueprints}}
        {{#each blueprints}}
          <button type="button" class="encounter-forge-blueprint-row {{#if selected}}selected{{/if}}" data-action="selectBlueprint" data-blueprint-id="{{id}}">
            <span class="encounter-forge-blueprint-name">{{name}}</span>
            <span class="encounter-forge-blueprint-meta">{{localize "PF2E_ENCOUNTER_FORGE.Library.PartyShort"}} {{partySize}} × {{partyLevel}} · {{threat}}</span>
          </button>
        {{/each}}
      {{else}}
        <div class="encounter-forge-empty-state">
          <i class="fa-regular fa-folder-open"></i>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Library.Empty"}}</p>
        </div>
      {{/if}}
    </div>

    <footer class="encounter-forge-library-footer">
      <button type="button" class="encounter-forge-integrations-toggle" data-action="toggleIntegrations">
        <span><i class="fa-solid fa-plug"></i> {{readyIntegrations}} / {{totalIntegrations}} {{localize "PF2E_ENCOUNTER_FORGE.Library.IntegrationsReady"}}</span>
        <i class="fa-solid {{#if integrationsExpanded}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i>
      </button>

      {{#if integrationsExpanded}}
        <section class="encounter-forge-integrations-panel">
          <header>
            <strong>{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Title"}}</strong>
            <small>{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Hint"}}</small>
          </header>
          <div class="encounter-forge-integration-list">
            {{#each integrationRows}}
              <div class="encounter-forge-integration-row" data-state="{{state}}">
                <div class="encounter-forge-integration-info">
                  <strong>{{label}}</strong>
                  <small>{{statusLabel}}{{#if versionText}} · {{versionText}}{{/if}}</small>
                </div>
                <button type="button" class="encounter-forge-integration-switch {{#if enabled}}enabled{{else}}disabled{{/if}}"
                        data-action="toggleIntegration" data-integration-id="{{id}}"
                        {{#unless canToggle}}disabled{{/unless}}
                        data-tooltip="{{toggleLabel}}">
                  <i class="fa-solid {{#if enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
                </button>
              </div>
            {{/each}}
          </div>
          <p class="encounter-forge-integrations-note">{{localize "PF2E_ENCOUNTER_FORGE.Integrations.Note"}}</p>
        </section>
      {{/if}}
    </footer>
  </aside>

  <main class="encounter-forge-editor">
    <header class="encounter-forge-editor-header">
      <div>
        <div class="encounter-forge-kicker">{{localize "PF2E_ENCOUNTER_FORGE.Editor.Blueprint"}}</div>
        <h1>{{draft.name}}</h1>
      </div>
      <div class="encounter-forge-save-state {{#if isDirty}}dirty{{else}}clean{{/if}}" data-dirty-indicator>
        <i class="fa-solid {{#if isDirty}}fa-pen{{else}}fa-check{{/if}}"></i>
        <span data-dirty-text>{{#if isDirty}}{{localize "PF2E_ENCOUNTER_FORGE.Editor.UnsavedChanges"}}{{else}}{{localize "PF2E_ENCOUNTER_FORGE.Editor.AllChangesSaved"}}{{/if}}</span>
      </div>
    </header>

    <section class="encounter-forge-card">
      <div class="encounter-forge-section-title">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Editor.Basics"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Editor.BasicsHint"}}</p>
        </div>
      </div>

      <div class="encounter-forge-form-grid">
        <label class="wide">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}</span>
          <input type="text" name="name" value="{{draft.name}}" data-blueprint-field>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.PartyLevel"}}</span>
          <input type="number" name="partyLevel" min="1" max="20" value="{{draft.party.level}}" data-blueprint-field>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.PartySize"}}</span>
          <input type="number" name="partySize" min="1" max="12" value="{{draft.party.size}}" data-blueprint-field>
        </label>

        <div class="encounter-forge-party-detection wide">
          <div class="encounter-forge-party-detection-text">
            <i class="fa-solid fa-people-group"></i>
            {{#if partyDetection.available}}
              <span>
                {{localize "PF2E_ENCOUNTER_FORGE.Party.Detected"}}:
                <strong>{{partyDetection.size}}</strong> {{localize "PF2E_ENCOUNTER_FORGE.Party.PCs"}},
                {{localize "PF2E_ENCOUNTER_FORGE.Party.Average"}} <strong>{{partyDetection.averageLevelText}}</strong>
                → {{localize "PF2E_ENCOUNTER_FORGE.Fields.PartyLevel"}} <strong>{{partyDetection.partyLevel}}</strong>
                <small>({{partyDetection.sourceLabel}}{{#if partyDetection.sourceName}}: {{partyDetection.sourceName}}{{/if}})</small>
              </span>
            {{else}}
              <span>{{localize "PF2E_ENCOUNTER_FORGE.Party.NotDetected"}}</span>
            {{/if}}
          </div>
          <button type="button" data-action="detectParty" class="secondary">
            <i class="fa-solid fa-rotate"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.DetectParty"}}
          </button>
        </div>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Threat"}}</span>
          <select name="threatTarget" data-blueprint-field>
            {{#each threatOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>

        <label>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Budget"}}</span>
          <input type="number" name="threatBudget" min="0" step="1" value="{{draft.threatBudget}}" placeholder="—" data-blueprint-field>
        </label>

        <label class="wide">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Description"}}</span>
          <textarea name="description" rows="5" data-blueprint-field>{{draft.description}}</textarea>
        </label>
      </div>
    </section>

    <section class="encounter-forge-card encounter-forge-participants-card">
      <div class="encounter-forge-section-title encounter-forge-participants-heading">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Title"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Hint"}}</p>
        </div>
        <div class="encounter-forge-participant-actions">
          <button type="button" data-action="browseParticipant" class="secondary">
            <i class="fa-solid fa-book-open"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.BrowseActors"}}
          </button>
          <button type="button" data-action="addCreatureForgeParticipant" class="secondary" {{#unless creatureForgeReady}}disabled{{/unless}}>
            <i class="fa-solid fa-dragon"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.CreatureForge"}}
          </button>
          <button type="button" data-action="addNpcForgeParticipant" class="secondary" {{#unless npcForgeReady}}disabled{{/unless}}>
            <i class="fa-solid fa-user-tie"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.NpcForge"}}
          </button>
        </div>
      </div>

      <div class="encounter-forge-participant-drop" data-participant-drop>
        <i class="fa-solid fa-arrow-down-to-bracket"></i>
        <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.DropHint"}}</span>
      </div>

      <div class="encounter-forge-budget-summary" data-budget-summary data-status="{{budget.status}}">
        <div>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.Used"}}</span>
          <strong><span data-budget-used>{{budget.usedXp}}</span> / <span data-budget-target>{{budget.targetXp}}</span> EP</strong>
        </div>
        <div>
          <span data-budget-remaining-label>{{budget.remainingLabel}}</span>
          <strong><span data-budget-remaining>{{budget.remainingAbs}}</span> EP</strong>
        </div>
        <div>
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.StatusLabel"}}</span>
          <strong data-budget-status>{{budget.statusLabel}}</strong>
        </div>
        <div class="encounter-forge-budget-auto">
          <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.AutomaticTarget"}}</span>
          <strong><span data-budget-automatic>{{budget.automaticTarget}}</span> EP</strong>
        </div>
      </div>

      <div class="encounter-forge-budget-warning" data-budget-warning {{#unless budget.unknownCount}}hidden{{/unless}}>
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "PF2E_ENCOUNTER_FORGE.Budget.UnknownHint"}}
      </div>

      {{#if hasParticipants}}
        <div class="encounter-forge-participant-list">
          {{#each participants}}
            <article class="encounter-forge-participant" data-participant-id="{{id}}">
              <div class="encounter-forge-participant-identity">
                <div class="encounter-forge-participant-portrait">
                  {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fa-solid fa-user-shield"></i>{{/if}}
                </div>
                <div class="encounter-forge-participant-name">
                  <input type="text" value="{{name}}" data-participant-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Fields.Name"}}">
                  <span class="encounter-forge-source-badge">{{sourceLabel}}</span>
                </div>
                <div class="encounter-forge-participant-row-actions">
                  {{#if canEditSource}}
                    <button type="button" data-action="editParticipant" data-participant-id="{{id}}" class="icon-only" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.EditSource">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                  {{/if}}
                  <button type="button" data-action="removeParticipant" data-participant-id="{{id}}" class="icon-only danger" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.Remove">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
              <div class="encounter-forge-participant-fields">
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Fields.Level"}}</span>
                  <input type="number" min="-1" max="24" step="1" value="{{levelValue}}" placeholder="—" data-participant-field="level">
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Quantity"}}</span>
                  <input type="number" min="1" max="99" step="1" value="{{quantity}}" data-participant-field="quantity">
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.RoleLabel"}}</span>
                  <select data-participant-field="role">
                    {{#each roleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
                <label>
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupLabel"}}</span>
                  <select data-participant-field="groupId">
                    {{#each groupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </select>
                </label>
                <div class="encounter-forge-participant-xp {{#unless budgetSupported}}unsupported{{/unless}}">
                  <span>{{localize "PF2E_ENCOUNTER_FORGE.Budget.ParticipantXp"}}</span>
                  <strong><span data-participant-xp="{{id}}">{{xpText}}</span> EP</strong>
                  <small><span data-participant-xp-each="{{id}}">{{xpEachText}}</span> × <span data-participant-xp-quantity="{{id}}">{{quantity}}</span></small>
                </div>
              </div>
            </article>
          {{/each}}
        </div>
      {{else}}
        <div class="encounter-forge-participant-empty">
          <i class="fa-solid fa-people-group"></i>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.Empty"}}</p>
        </div>
      {{/if}}

      <div class="encounter-forge-groups">
        <div class="encounter-forge-groups-header">
          <div>
            <h3>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupsTitle"}}</h3>
            <p>{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupsHint"}}</p>
          </div>
          <button type="button" data-action="addGroup" class="secondary">
            <i class="fa-solid fa-plus"></i> {{localize "PF2E_ENCOUNTER_FORGE.Participants.AddGroup"}}
          </button>
        </div>
        {{#if hasGroups}}
          <div class="encounter-forge-group-list">
            {{#each groups}}
              <div class="encounter-forge-group-row" data-group-id="{{id}}">
                <i class="fa-solid fa-object-group"></i>
                <input type="text" value="{{name}}" data-group-field="name" aria-label="{{localize "PF2E_ENCOUNTER_FORGE.Participants.GroupLabel"}}">
                <button type="button" data-action="removeGroup" data-group-id="{{id}}" class="icon-only danger" data-tooltip="PF2E_ENCOUNTER_FORGE.Participants.RemoveGroup">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </section>

    <section class="encounter-forge-card encounter-forge-structure-card">
      <div class="encounter-forge-section-title">
        <div>
          <h2>{{localize "PF2E_ENCOUNTER_FORGE.Editor.Structure"}}</h2>
          <p>{{localize "PF2E_ENCOUNTER_FORGE.Editor.StructureHint"}}</p>
        </div>
      </div>

      <div class="encounter-forge-stat-grid">
        <div class="encounter-forge-stat"><strong data-structure-participant-count>{{draft.participantCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Participants"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.groupCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Groups"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.objectiveCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Objectives"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.phaseCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Phases"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.triggerCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Triggers"}}</span></div>
        <div class="encounter-forge-stat"><strong>{{draft.actionCount}}</strong><span>{{localize "PF2E_ENCOUNTER_FORGE.Structure.Actions"}}</span></div>
      </div>

      <div class="encounter-forge-foundation-note">
        <i class="fa-solid fa-compass-drafting"></i>
        <span>{{localize "PF2E_ENCOUNTER_FORGE.Editor.FoundationNote"}}</span>
      </div>
    </section>

    <footer class="encounter-forge-editor-actions">
      <div>
        <button type="button" data-action="duplicateBlueprint" class="secondary">
          <i class="fa-regular fa-copy"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Duplicate"}}
        </button>
        <button type="button" data-action="deleteBlueprint" class="secondary danger" {{#unless isSaved}}disabled{{/unless}}>
          <i class="fa-solid fa-trash"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Delete"}}
        </button>
      </div>
      <div class="encounter-forge-editor-actions-primary">
        <button type="button" data-action="deployEncounter" class="secondary deploy" {{#unless canDeploy}}disabled{{/unless}}>
          <i class="fa-solid fa-people-arrows"></i> {{localize "PF2E_ENCOUNTER_FORGE.Deployment.Deploy"}}
        </button>
        <button type="button" data-action="saveBlueprint" class="primary">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "PF2E_ENCOUNTER_FORGE.Controls.Save"}}
        </button>
      </div>
    </footer>
  </main>
</div>
